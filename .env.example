# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real secrets to this file.

# --- Site-wide ---
NEXT_PUBLIC_SITE_URL=https://www.ibomblockchain.com
NEXT_PUBLIC_REGISTRATION_URL=https://form.typeform.com/to/A2YCJwL2
NEXT_PUBLIC_TANGEM_AFFILIATE_URL=https://example.com/tangem-affiliate

# --- Supabase (forms → database) ---
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — never prefix this with NEXT_PUBLIC_, or it ships to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (team notifications + email confirmation) ---
# Optional: forms still work without this, they just skip sending email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=IBX <updates@contacts.ibomblockchain.com>
PARTNERSHIPS_NOTIFY_EMAIL=partnerships@ibomblockchain.com
