# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real secrets to this file.

# --- Site-wide ---
NEXT_PUBLIC_SITE_URL=https://www.ibomblockchain.com
NEXT_PUBLIC_REGISTRATION_URL=https://form.typeform.com/to/A2YCJwL2
NEXT_PUBLIC_TANGEM_AFFILIATE_URL=https://example.com/tangem-affiliate

# Optional extra layer on the forms' Origin check (lib/forms/request-origin.ts).
# Comma-separated, hostnames only (no protocol). Leave unset and the check
# still works correctly — this only adds a second, explicit allowlist on
# top of it. An unset value here is safe: it's skipped, not enforced-empty.
ALLOWED_ORIGIN_HOSTS=ibomblockchain.com,www.ibomblockchain.com

# --- Supabase (forms → database) ---
# Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — never prefix this with NEXT_PUBLIC_, or it ships to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (team notifications + email confirmation) ---
# Optional: forms still work without this, they just skip sending email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=IBX <updates@contacts.ibomblockchain.com>
# Each form notifies whichever real mailbox owns that business — verified
# against the team's actual live mailbox list, not assumed.
PARTNERSHIPS_NOTIFY_EMAIL=partnerships@ibomblockchain.com
AMBASSADOR_NOTIFY_EMAIL=ambassador@ibomblockchain.com
TOUR_NOTIFY_EMAIL=tour@ibomblockchain.com

# --- Cloudflare Turnstile (bot check on Contact + Partner Application) ---
# Optional: forms still work without these, they just skip the bot check.
# dash.cloudflare.com -> Turnstile -> Add widget -> your domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx
